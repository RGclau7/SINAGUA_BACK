# Variables para la nube (Render u otra). Aquí NO van contraseñas reales: cada valor se escribe
# en el panel de la plataforma ("Environment"). Ver ../DESPLIEGUE-NUBE.md.

APP_NAME=SINAGUA
APP_ENV=production
APP_DEBUG=false
# Se genera una sola vez: docker compose exec api php artisan key:generate --show
APP_KEY=
# La dirección que da la plataforma, por ejemplo https://sinagua.onrender.com
APP_URL=
SINAGUA_PUBLIC_URL=
TRUSTED_PROXIES=*
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# JWT de la API (si se deja vacío se deriva de APP_KEY). Una cadena larga y aleatoria.
JWT_SECRET=

# Base de datos PostgreSQL (Neon u otra): la cadena de conexión completa.
DB_CONNECTION=pgsql
DB_URL=
# Neon exige SSL.
DB_SSLMODE=require

# Sesiones, caché y cola en la base (no hay disco permanente en la capa gratuita).
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=sync

# Fotos de perfil y comprobantes: almacenamiento compatible con S3 (Cloudflare R2 u otro).
SINAGUA_COMPROBANTES_DISK=s3
SINAGUA_FOTOS_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=sinagua
# R2: https://<ID_DE_CUENTA>.r2.cloudflarestorage.com
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true

# Correo (Brevo u otro proveedor SMTP).
MAIL_MAILER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=SINAGUA

# Seguridad de PIN y códigos
ACTIVATION_PIN_HOURS=48
PIN_MAX_ATTEMPTS=5
LOGIN_PIN_MINUTES=15
ADMIN_TWO_FACTOR=true
TRUSTED_DEVICE_DAYS=180
SECURITY_PIN_MAX_ATTEMPTS=5
SECURITY_PIN_LOCKOUT_MINUTES=15
AUTORIZACION_MINUTES=30
AUTH_MAX_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15

# Primer superadministrador: se crea al arrancar si no existe (después puede borrar la contraseña de aquí).
SINAGUA_SUPERADMIN_EMAIL=
SINAGUA_SUPERADMIN_NOMBRE=
SINAGUA_SUPERADMIN_PASSWORD=

# Al arrancar se aplican las migraciones (solo agregan; no borran datos).
RUN_MIGRATIONS=true
