APP_NAME=SINAGUA
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8081
APP_PORT=8081

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_MX

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Autenticación (M1): bloqueo tras N intentos, minutos de bloqueo, minutos de inactividad
# que expiran el token y vida máxima del token en horas.
AUTH_MAX_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
AUTH_IDLE_MINUTES=30
AUTH_TOKEN_LIFETIME_HOURS=12

# JWT de la API (HS256). Si JWT_SECRET queda vacío, la llave se deriva de APP_KEY.
# Para fijarla: JWT_SECRET=base64:$(openssl rand -base64 32)  (mínimo 32 bytes)
JWT_SECRET=
JWT_AUDIENCE=sinagua-api
JWT_LEEWAY_SECONDS=30

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=sinagua
DB_USERNAME=sinagua
# Rol de la API: sin superusuario ni BYPASSRLS (lo crea docker/postgres/init-app-role.sh).
# Cambie las contraseñas en su .env local; nunca las suba al repositorio.
DB_PASSWORD=cambiar-esta-contrasena
# Superusuario "postgres", solo para administración (no lo use en la API).
DB_ROOT_PASSWORD=cambiar-esta-contrasena-root
DB_FORWARD_PORT=5433

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Correo en desarrollo: Mailpit (docker compose) muestra los correos en http://localhost:8025.
# Con MAIL_MAILER=log los correos quedan en storage/logs/laravel.log. En la nube: ver DESPLIEGUE-NUBE.md.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-responder@sinagua.local"
MAIL_FROM_NAME="${APP_NAME}"

# MinIO: usuario y clave raíz del contenedor (cámbielos en su .env local)
AWS_ACCESS_KEY_ID=sinagua-minio
AWS_SECRET_ACCESS_KEY=cambiar-esta-clave
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=comprobantes
AWS_ENDPOINT=http://minio:9000
AWS_URL=http://localhost:9000/comprobantes
AWS_USE_PATH_STYLE_ENDPOINT=true
MINIO_FORWARD_PORT=9000
MINIO_CONSOLE_PORT=9001

VITE_APP_NAME="${APP_NAME}"

# Perfiles y seguridad
# Dirección pública para los enlaces de los correos (en la nube, la URL del servidor).
SINAGUA_PUBLIC_URL=http://localhost:8081
# Vigencia del PIN de activación (24 a 48 horas) e intentos antes de anularlo.
ACTIVATION_PIN_HOURS=48
PIN_MAX_ATTEMPTS=5
LOGIN_PIN_MINUTES=15
# Código al correo cuando un administrador entra en un equipo nuevo.
ADMIN_TWO_FACTOR=true
TRUSTED_DEVICE_DAYS=180
SECURITY_PIN_MAX_ATTEMPTS=5
SECURITY_PIN_LOCKOUT_MINUTES=15
